class Solution {
    public int addDigits(int n) {
        if(n==0)
        {
            return 0;
        }
        while(n>=10)
        {
            int sum=0;
            while(n>0)
            {
                int digit=n%10;
                sum+=digit;
                n=n/10;
            }
            n=sum;
        }
        return n;
    }
}
